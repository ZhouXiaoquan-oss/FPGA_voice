// D2 merged constraints: audio full v3 (frozen) + R3 accepted DDR3 x16 pins.
// Generated by work/d2/tools/make_d2_cst.py; do not hand-edit for evidence builds.
// Conflicts resolved: AA13=audio key[0] (DDR3 reset is internal POR sync),
// P16/R17=MPR121 I2C (probe state_led[3:2] dropped), probe UART dropped.
// VCCX must be 1.8; DDR banks 9/10/11 VCCIO=1.5; audio banks 6/7/8 VCCIO=3.3.

//Copyright (C)2014-2024 Gowin Semiconductor Corporation.
//All rights reserved.
//File Title: Physical Constraints file
//Part Number: GW5AT-LV60PG484AC1/I0
//Device: GW5AT-60B
//Device Version: B
//
// p6_touch (SubTask-004-A): SubTask-003-A's constraint file with the MPR121
// touch chain integrated. The 12 Task-003 key pin placeholders are DELETED here
// (the 12 touch electrodes are internal key_bus signals now, not pins), the three
// onboard keys stay, and P16 / R17 are PERMANENTLY given up to the I2C bus (they
// used to be led[3] / led[2]) -- so this file constrains 2 LEDs, not 4, and three
// note keys, not 15. PT8211 I2S master + UART + MPR121 on J9.
// 鏈枃浠朵笉鍚换浣曡绂佺敤璋冭瘯鎺掗拡涓婄殑寮曡剼 (璇ユ帓閽堝湪鏈?dock 涓婁笉鍙敤, 瑙?MPR121
// 浜嬪疄鍗?搂1.2 涓?Task-008 H6 璁板綍); I2C 鍙蛋 J9 鐨?P16 / R17銆?// Pin facts verified against
//   docs/02_Sipeed鏉垮崱/pin_constraints/tang_mega_60K_pins.cst
//   docs/02_Sipeed鏉垮崱/schematic/DOCK/...31004...pdf  (bank numbers, page 6/7/9)
//
// ============================================================================
// UART rxp = V14 : the official .cst has TWO commented-out variants and the
// 31004 one is self-contradictory (IO_TYPE=LVCMOS15 but BANK_VCCIO=3.3).
// Resolved from the schematic, not by guessing:
//   * page 7 : "BANK8_V14_IOB91B"      -> V14 is in BANK8
//              "BANK8_U15_IOB130B"     -> txp (U15) is in BANK8 as well
//   * page 6 : "BANK8_R17_IOB136B", "BANK8_T18_IOB144B",
//              "BANK8_R18_IOB144A", "BANK8_P16_IOB136A"
//                                      -> LED pins are in BANK8 too
//   The 8 LEDs are common-anode (anodes on the 3.3 V rail) and the official
//   file declares them LVCMOS33 / BANK_VCCIO=3.3 -> BANK8 IS 3.3 V.
//   Therefore V14 must be LVCMOS33, and the official LVCMOS15 is a copy-paste
//   leftover from the old 31002 pin (Y14, which really is BANK6 1.5 V).
// PULL_MODE=UP on rxp: UART idle is HIGH. If 澶栨帴 FT2232H 閫氶亾B (COM6) is not
//   connected the pin would otherwise float and noise could be decoded as
//   start bits, firing random notification beeps / test-mode toggles.
// ============================================================================

//========================== System clock ==========================
// 50 MHz onboard oscillator (SOM Y1100). Same period as the AX515 design
// (voice.sdc used -period 20), so the old timing intent carries over.
IO_LOC  "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

//========================== Note keys (3 onboard) =================
// SubTask-004-A: only the three ONBOARD keys are still pins of this design. The
// 12 MPR121 electrodes used to be 12 placeholder input pins here (SubTask-003);
// they are internal signals now -- mpr121 -> touch_hi -> key_bus[11:0] -- and the
// physical link to the touch chip is the I2C bus constrained further below.
//   key[0] = AA13 = S4 = USER_BUTTON0  (also the power-on test-mode gesture key)
//   key[1] = AB13 = S2 = USER_BUTTON1
//   key[2] = Y12  = S1 = USER_BUTTON2
// All three sit in BANK9, which is 1.5 V on this dock, and the keys have no
// external pull-up (pressed = short to GND) -> LVCMOS15 + internal pull-up.
// All three are electrically identical; the official example merely uses AA13
// as sys_rst_n. p6_touch uses all three as note keys and resets via POR; AA13
// (key[0] at the port, key_bus[12] inside the design) is the gesture key.
IO_LOC  "key[0]" AA13;
IO_PORT "key[0]" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

IO_LOC  "key[1]" AB13;
IO_PORT "key[1]" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

IO_LOC  "key[2]" Y12;
IO_PORT "key[2]" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

//========================== I2C to the MPR121 (J9) ================
// SubTask-004-A: the touch controller hangs on the J9 header (Task-008 H6,
// measured 2026-10-11): J9 pin 7 = SCL -> P16, J9 pin 8 = SDA -> R17, and the
// module's ADD is tied to GND, i.e. the 7-bit address is 0x5A. The IRQ pin is
// not used (mpr121 polls the touch-status registers every 5 ms), so no extra pin
// is needed here.
// The module already carries 10k pull-ups on both lines (measured); the internal
// PULL_MODE=UP is belt-and-braces for the unplugged case so the pins are never
// left floating/undefined. SCL is push-pull (i2c_master drives it), SDA is open
// drain; DRIVE=8 follows the H6 draft that was cross-checked against the dock
// schematic. Nothing else may be assigned to these two pins.
IO_LOC  "i2c_scl" P16;
IO_PORT "i2c_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "i2c_sda" R17;
IO_PORT "i2c_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

//========================== AUDIO =================================
// FPGA is the I2S MASTER: BCK/WS are outputs here (PT8211 is a pure slave DAC).
// All four sit in BANK7 with VCCIO = 3.3 V (official .cst, AUDIO section).
IO_LOC  "HP_BCK" Y17;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "HP_WS" AB17;
IO_PORT "HP_WS" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "HP_DIN" AA16;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// PA_EN -> NS4263 SD. ACTIVE LOW: PA_EN=0 turns the amplifier ON.
IO_LOC  "PA_EN" AB16;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

//========================== UART (notify + test mode) =============
// V14 = 澶栨帴 FT2232H 閫氶亾B (COM6) TXD -> FPGA input. BANK8 = 3.3 V (see the
// header note).
IO_LOC  "uart_rxd" V14;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

//========================== LEDS (2 left after I2C) ===============
// Common anode: driving the pin LOW lights the LED.
//   led[0] = R18 = POR released (running)
//   led[1] = T18 = at least one voice is sounding
// SubTask-004-A: led[2] (R17) and led[3] (P16) are GONE -- those two pins are
// permanently the I2C SDA/SCL now (see the I2C section above), which is also why
// the test-mode blink indicator disappeared: there is no third indicator pin
// left. The test-mode logic itself is unchanged.
//
// The official tang_mega_60K_pins.cst lists EIGHT LED pins. Four of them do
// not exist as usable I/O on GW5AT-60B (this part + package):
//   U21 (IOB115[B], CFG D05)  T21 (IOB115[A], CFG D04)
//   R19 (IOB113[B], CFG D07)  P19 (IOB113[A], CFG D06)
// PnR rejects them with:
//   ERROR (PR2028) : The constrained location is useless in current package
//   ERROR (PR2017) : 'led[n]' cannot be placed according to constraint,
//                    for the location is a dedicated pin (CPU)
// The project option "CPU" is already false, so they cannot be freed. That is
// why the LED count was four and is now two.
IO_LOC  "led[0]" R18;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "led[1]" T18;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "uart_txd" U15;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;

//========================== Screen UART (J8 = PMOD1) ==============
// W5 (Task-017): the TJC serial screen gets its OWN UART so its 0x65 event
// frames never share a receiver with the PC command channel.
// Ball numbers are authoritative (dock schematic p19 + BTB page 6/7):
//   J8 pin 9  = PMOD1_IO2 = AB21 = BANK8 = 3.3 V -> screen TX -> FPGA rxd2
//   J8 pin 10 = PMOD1_IO3 = AB22 = BANK8 = 3.3 V <- FPGA txd2 <- screen RX
// (The L1 note of 2026-10-23 swapped the two PIN numbers; the BALL assignment
//  AB21/AB22 in that note is what is followed here and what PnR was probed on.)
// PULL_MODE=UP on rxd2: UART idle is HIGH. With the screen unplugged the pin
// would otherwise float; a floating RX can decode noise as a 0x65 header and
// open a frame that never completes (1 ms timeout, but still a false in_frame
// window that would swallow PC bytes).
// AB21/AB22 are CFG-reused pins (D14/D15) on this board: after configuration
// they are ordinary I/O; the screen TX idle-HIGH direction matches the CFG
// pin's weak pull-up, so the reuse is direction-safe (L1 ruling 2026-10-23).
IO_LOC  "uart_rxd2" AB21;
IO_PORT "uart_rxd2" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC  "uart_txd2" AB22;
IO_PORT "uart_txd2" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;

//================ imported from accepted R3 probe.cst ================
